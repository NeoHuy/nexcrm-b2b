<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center space-x-2">
        <i data-lucide="receipt" class="w-6 h-6 text-rose-600"></i>
        <span>Sổ Theo dõi & Thu hồi Công nợ B2B</span>
      </h1>
      <p class="text-xs text-slate-500 mt-1">Giám sát các khoản phải thu doanh nghiệp, hạn mức tín dụng và lịch hẹn thanh toán</p>
    </div>

    <!-- Quick Filter Tabs -->
    <div class="flex items-center bg-white p-1 rounded-xl border border-slate-200 shadow-sm text-xs font-semibold">
      <a href="<%= debts_path(filter: 'all') %>" class="px-3 py-1.5 rounded-lg transition <%= @filter == 'all' ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900' %>">
        Tất cả còn nợ (<%= Customer.with_debt.count %>)
      </a>
      <a href="<%= debts_path(filter: 'overdue') %>" class="px-3 py-1.5 rounded-lg transition flex items-center space-x-1 <%= @filter == 'overdue' ? 'bg-rose-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900' %>">
        <span>Quá hạn</span>
        <% if @overdue_count > 0 %>
          <span class="px-1.5 py-0.2 rounded-full text-[10px] <%= @filter == 'overdue' ? 'bg-white text-rose-700' : 'bg-rose-100 text-rose-700' %>"><%= @overdue_count %></span>
        <% end %>
      </a>
      <a href="<%= debts_path(filter: 'due_soon') %>" class="px-3 py-1.5 rounded-lg transition <%= @filter == 'due_soon' ? 'bg-amber-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900' %>">
        Sắp đến hạn 7 ngày
      </a>
    </div>
  </div>

  <!-- 3 Summary Metrics -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Tổng công nợ B2B hiện tại</span>
      <div class="text-2xl font-black text-slate-900 mt-1"><%= format_vnd(@total_debt) %></div>
      <p class="text-xs text-slate-400 mt-1">Tổng các khoản phải thu toàn hệ thống</p>
    </div>

    <div class="bg-rose-50/70 p-5 rounded-2xl border border-rose-200 shadow-sm">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-rose-700">Công nợ quá hạn (Cần thu hồi ngay)</span>
        <span class="w-6 h-6 rounded-full bg-rose-600 text-white flex items-center justify-center text-xs font-bold"><%= @overdue_count %></span>
      </div>
      <div class="text-2xl font-black text-rose-600 mt-1"><%= format_vnd(@overdue_debt) %></div>
      <p class="text-xs text-rose-600 mt-1 font-medium">CS & Sales cần chủ động liên hệ đôn đốc</p>
    </div>

    <div class="bg-amber-50/70 p-5 rounded-2xl border border-amber-200 shadow-sm">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Nợ sắp đến hạn trong tuần</span>
      <div class="text-2xl font-black text-amber-600 mt-1"><%= format_vnd(@due_soon_debt) %></div>
      <p class="text-xs text-amber-600 mt-1 font-medium">Chuẩn bị gửi thông báo đối soát công nợ</p>
    </div>
  </div>

  <!-- Receivables Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-bold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3.5 px-4">Doanh nghiệp khách hàng</th>
            <th class="py-3.5 px-4">Đại diện liên hệ & SĐT</th>
            <th class="py-3.5 px-4">Công nợ hiện tại</th>
            <th class="py-3.5 px-4">Hạn mức tín dụng</th>
            <th class="py-3.5 px-4">Hạn thanh toán</th>
            <th class="py-3.5 px-4">Tình trạng nợ</th>
            <th class="py-3.5 px-4">Nhân viên phụ trách</th>
            <th class="py-3.5 px-4 text-right">Thao tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-700">
          <% if @customers.empty? %>
            <tr>
              <td colspan="8" class="py-12 text-center text-slate-400">
                <i data-lucide="check-circle-2" class="w-10 h-10 mx-auto text-emerald-400 mb-2"></i>
                Không có doanh nghiệp nào có công nợ theo tiêu chí đã chọn.
              </td>
            </tr>
          <% else %>
            <% @customers.each do |c| %>
              <tr class="hover:bg-indigo-50/20 transition">
                <!-- Company -->
                <td class="py-3.5 px-4">
                  <a href="<%= customer_path(c) %>" class="font-bold text-slate-900 hover:text-indigo-600 text-sm block">
                    <%= c.company_name %>
                  </a>
                  <span class="text-[11px] text-slate-500 font-mono">MST: <%= c.tax_code || '---' %></span>
                </td>

                <!-- Contact -->
                <td class="py-3.5 px-4">
                  <span class="font-bold text-slate-800 block"><%= c.contact_name %></span>
                  <span class="text-[11px] text-slate-500 font-mono"><%= c.contact_phone %></span>
                </td>

                <!-- Debt -->
                <td class="py-3.5 px-4">
                  <span class="font-black text-sm <%= c.overdue? ? 'text-rose-600' : 'text-slate-900' %>">
                    <%= format_vnd(c.current_debt) %>
                  </span>
                </td>

                <!-- Credit Limit -->
                <td class="py-3.5 px-4">
                  <span class="font-semibold text-slate-600"><%= format_vnd(c.credit_limit) %></span>
                  <div class="w-20 bg-slate-200 rounded-full h-1.5 mt-1">
                    <div class="h-1.5 rounded-full <%= c.credit_utilization > 80 ? 'bg-rose-500' : 'bg-indigo-600' %>" style="width: <%= c.credit_utilization %>%"></div>
                  </div>
                </td>

                <!-- Due Date -->
                <td class="py-3.5 px-4">
                  <span class="font-medium text-slate-800 block">
                    <%= c.payment_due_date ? c.payment_due_date.strftime("%d/%m/%Y") : 'Chưa đặt' %>
                  </span>
                  <% if c.overdue? %>
                    <span class="text-[10px] text-rose-600 font-bold block">Trễ <%= c.days_overdue %> ngày</span>
                  <% end %>
                </td>

                <!-- Badge -->
                <td class="py-3.5 px-4">
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded border inline-block <%= c.debt_badge[:class] %>">
                    <%= c.debt_badge[:label] %>
                  </span>
                </td>

                <!-- Assigned -->
                <td class="py-3.5 px-4">
                  <span class="font-medium text-slate-800"><%= c.assigned_user&.name || 'Chưa chỉ định' %></span>
                  <span class="text-[10px] text-slate-400 block"><%= c.assigned_user&.role_label %></span>
                </td>

                <!-- Actions -->
                <td class="py-3.5 px-4 text-right">
                  <a href="<%= customer_path(c) %>" class="px-3 py-1.5 text-xs font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition inline-flex items-center space-x-1">
                    <span>Xử lý nợ</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                  </a>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
