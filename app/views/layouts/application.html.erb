<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-50">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>NexCRM B2B - Nền tảng SaaS Quản lý Khách hàng & Công nợ</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#eef2ff',
                100: '#e0e7ff',
                500: '#6366f1',
                600: '#4f46e5',
                700: '#4338ca',
                800: '#3730a3',
                900: '#312e81',
              }
            }
          }
        }
      }
    </script>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    </style>
  </head>

  <body class="h-full flex flex-col text-slate-800 antialiased selection:bg-indigo-500 selection:text-white">
    <% if logged_in? %>
      <!-- Navbar -->
      <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16 items-center">
            <div class="flex items-center space-x-8">
              <!-- Logo -->
              <a href="<%= dashboard_path %>" class="flex items-center space-x-2.5 font-bold text-xl tracking-tight text-slate-900 group">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-md shadow-indigo-100 group-hover:scale-105 transition">
                  <i data-lucide="building-2" class="w-5 h-5"></i>
                </div>
                <div class="flex flex-col">
                  <span class="leading-none text-lg">NexCRM<span class="text-indigo-600 font-extrabold">.B2B</span></span>
                  <span class="text-[10px] uppercase font-semibold text-slate-400 tracking-wider">SaaS Platform</span>
                </div>
              </a>

              <!-- Navigation Links -->
              <nav class="hidden md:flex items-center space-x-1">
                <a href="<%= dashboard_path %>" 
                   class="px-3.5 py-2 text-sm font-semibold rounded-lg transition flex items-center space-x-1.5 <%= current_page?(dashboard_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
                  <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                  <span>Tổng quan</span>
                </a>

                <a href="<%= customers_path %>" 
                   class="px-3.5 py-2 text-sm font-semibold rounded-lg transition flex items-center space-x-1.5 <%= current_page?(customers_path) || request.path.start_with?('/customers') ? 'bg-indigo-50 text-indigo-700' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
                  <i data-lucide="briefcase" class="w-4 h-4"></i>
                  <span>Khách hàng B2B</span>
                </a>

                <a href="<%= debts_path %>" 
                   class="px-3.5 py-2 text-sm font-semibold rounded-lg transition flex items-center space-x-1.5 <%= current_page?(debts_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %>">
                  <i data-lucide="receipt" class="w-4 h-4"></i>
                  <span>Quản lý Công nợ</span>
                  <% overdue_cnt = Customer.overdue_debts.count %>
                  <% if overdue_cnt > 0 %>
                    <span class="ml-1 px-1.5 py-0.5 text-xs font-bold rounded-full bg-rose-500 text-white"><%= overdue_cnt %></span>
                  <% end %>
                </a>
              </nav>
            </div>

            <!-- Right section: User role info & quick switch -->
            <div class="flex items-center space-x-3">
              <!-- Quick Role Switch dropdown / buttons -->
              <div class="hidden sm:flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs font-medium">
                <span class="px-2 text-slate-400">Đổi vai trò:</span>
                <%= button_to "Sales", demo_login_path(role: "sales"), method: :post, class: "px-2.5 py-1 rounded-lg transition #{current_user.sales? ? 'bg-white text-blue-700 shadow-sm font-bold' : 'text-slate-600 hover:text-slate-900'}" %>
                <%= button_to "CS", demo_login_path(role: "cs"), method: :post, class: "px-2.5 py-1 rounded-lg transition #{current_user.cs? ? 'bg-white text-emerald-700 shadow-sm font-bold' : 'text-slate-600 hover:text-slate-900'}" %>
                <%= button_to "Marketing", demo_login_path(role: "marketing"), method: :post, class: "px-2.5 py-1 rounded-lg transition #{current_user.marketing? ? 'bg-white text-purple-700 shadow-sm font-bold' : 'text-slate-600 hover:text-slate-900'}" %>
              </div>

              <!-- Current User Badge -->
              <div class="flex items-center pl-2 space-x-2.5 border-l border-slate-200">
                <div class="w-9 h-9 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-sm shadow-sm ring-2 ring-indigo-100">
                  <%= current_user.name.split.last[0] rescue 'U' %>
                </div>
                <div class="hidden lg:flex flex-col text-left">
                  <span class="text-xs font-bold text-slate-800 leading-tight"><%= current_user.name %></span>
                  <span class="text-[11px] font-medium px-1.5 py-0.2 rounded border inline-block w-fit <%= current_user.role_badge_class %>">
                    <%= current_user.role_label %>
                  </span>
                </div>
                <a href="<%= logout_path %>" class="p-2 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition" title="Đăng xuất">
                  <i data-lucide="log-out" class="w-4 h-4"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </header>
    <% end %>

    <!-- Flash Notifications -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-4">
      <% if flash[:notice].present? %>
        <div class="p-4 mb-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between shadow-sm">
          <div class="flex items-center space-x-2.5">
            <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600"></i>
            <span class="font-medium"><%= flash[:notice] %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      <% end %>

      <% if flash[:alert].present? %>
        <div class="p-4 mb-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between shadow-sm">
          <div class="flex items-center space-x-2.5">
            <i data-lucide="alert-triangle" class="w-5 h-5 text-rose-600"></i>
            <span class="font-medium"><%= flash[:alert] %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      <% end %>
    </div>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-5 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 space-y-2 sm:space-y-0">
        <div class="flex items-center space-x-2">
          <span class="font-bold text-slate-700">NexCRM B2B Platform</span>
          <span>•</span>
          <span>Hệ thống CRM & Công nợ cho Doanh nghiệp SaaS</span>
        </div>
        <div class="flex items-center space-x-4">
          <span class="text-slate-400">Ruby on Rails 8 • Phiên bản 1.0 (MVP)</span>
        </div>
      </div>
    </footer>

    <script>
      // Initialize Lucide icons
      document.addEventListener("DOMContentLoaded", function() {
        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }
      });
    </script>
  </body>
</html>
