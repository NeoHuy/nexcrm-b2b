<div class="space-y-6">
  <!-- Top Header with Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center space-x-2">
        <span>Quản lý Khách hàng Doanh nghiệp (B2B)</span>
        <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-800 border border-indigo-200">
          <%= @customers.count %> hồ sơ
        </span>
      </h1>
      <p class="text-xs text-slate-500 mt-1">Hồ sơ công ty B2B, người liên hệ đại diện, quản trị công nợ và lịch sử chăm sóc</p>
    </div>

    <div class="flex items-center space-x-3">
      <a href="<%= new_customer_path %>" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-xl shadow-lg shadow-indigo-100 flex items-center space-x-2 transition">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Thêm khách hàng B2B mới</span>
      </a>
    </div>
  </div>

  <!-- Search & Multi-Filters Toolbar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
    <%= form_with url: customers_path, method: :get, class: "space-y-3" do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <!-- Search Query -->
        <div class="lg:col-span-2 relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <i data-lucide="search" class="w-4 h-4"></i>
          </div>
          <%= f.text_field :q, value: @query, placeholder: "Tìm theo tên công ty, MST, người liên hệ, SĐT...", class: "w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none" %>
        </div>

        <!-- Filter by Status -->
        <div>
          <%= f.select :status, options_for_select([["-- Mọi trạng thái --", ""]] + Customer::STATUSES.invert.to_a, @status), {}, class: "w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 outline-none" %>
        </div>

        <!-- Filter by Debt Status -->
        <div>
          <%= f.select :debt_filter, options_for_select([
            ["-- Tất cả công nợ --", ""],
            ["🚨 Nợ quá hạn", "overdue"],
            ["⚠️ Sắp đến hạn (7 ngày)", "due_soon"],
            ["💰 Đang có công nợ", "has_debt"],
            ["✅ Đã tất toán nợ", "settled"]
          ], @debt_filter), {}, class: "w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 outline-none font-medium" %>
        </div>

        <!-- Filter by Industry -->
        <div>
          <%= f.select :industry, options_for_select([["-- Mọi ngành nghề --", ""]] + Customer::INDUSTRIES.map { |i| [i, i] }, @industry), {}, class: "w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 outline-none" %>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2 border-t border-slate-100 text-xs">
        <div class="flex items-center space-x-2 text-slate-500">
          <i data-lucide="filter" class="w-3.5 h-3.5"></i>
          <span>Đang hiển thị <strong><%= @customers.count %></strong> / <strong><%= @total_count %></strong> khách hàng</span>
          <% if @overdue_count > 0 %>
            <span class="text-rose-600 font-bold ml-2">🚨 Có <%= @overdue_count %> khách hàng nợ quá hạn</span>
          <% end %>
        </div>

        <div class="flex items-center space-x-2">
          <% if @query.present? || @status.present? || @industry.present? || @debt_filter.present? %>
            <a href="<%= customers_path %>" class="px-3 py-1.5 text-xs text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-lg transition font-medium">
              Xóa bộ lọc
            </a>
          <% end %>
          <button type="submit" class="px-4 py-1.5 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition">
            Áp dụng bộ lọc
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <!-- B2B Customer Directory Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-600 font-bold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3.5 px-4">Tên Doanh nghiệp & MST</th>
            <th class="py-3.5 px-4">Đại diện liên hệ</th>
            <th class="py-3.5 px-4">Ngành nghề & Quy mô</th>
            <th class="py-3.5 px-4">Trạng thái</th>
            <th class="py-3.5 px-4">Công nợ hiện tại</th>
            <th class="py-3.5 px-4">Phụ trách</th>
            <th class="py-3.5 px-4 text-right">Thao tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-700">
          <% if @customers.empty? %>
            <tr>
              <td colspan="7" class="py-12 text-center text-slate-400">
                <i data-lucide="inbox" class="w-10 h-10 mx-auto text-slate-300 mb-2"></i>
                Không tìm thấy khách hàng B2B nào phù hợp với điều kiện tìm kiếm.
              </td>
            </tr>
          <% else %>
            <% @customers.each do |c| %>
              <tr class="hover:bg-indigo-50/30 transition group">
                <!-- Company Name & Tax -->
                <td class="py-3.5 px-4">
                  <div class="flex items-start space-x-3">
                    <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-800 font-bold flex items-center justify-center shrink-0 border border-slate-200 mt-0.5">
                      <%= c.company_name[0..1].upcase %>
                    </div>
                    <div>
                      <a href="<%= customer_path(c) %>" class="font-bold text-slate-900 hover:text-indigo-600 text-sm transition">
                        <%= c.company_name %>
                      </a>
                      <div class="flex items-center space-x-2 mt-0.5">
                        <span class="text-[11px] text-slate-500 font-mono">MST: <%= c.tax_code || '---' %></span>
                        <span class="text-[10px] px-1.5 py-0.2 rounded border <%= c.tier_badge[:class] %>">
                          <%= c.tier_badge[:label] %>
                        </span>
                      </div>
                      <% if c.website.present? %>
                        <a href="<%= c.website.start_with?('http') ? c.website : "https://#{c.website}" %>" target="_blank" class="text-[11px] text-indigo-500 hover:underline flex items-center mt-0.5">
                          <i data-lucide="globe" class="w-3 h-3 mr-1"></i><%= c.website %>
                        </a>
                      <% end %>
                    </div>
                  </div>
                </td>

                <!-- Key Contact Person -->
                <td class="py-3.5 px-4">
                  <div class="font-bold text-slate-900"><%= c.contact_name || 'Chưa cập nhật' %></div>
                  <div class="text-[11px] text-slate-500"><%= c.contact_title %></div>
                  <% if c.contact_phone.present? %>
                    <div class="text-[11px] text-slate-600 flex items-center mt-0.5">
                      <i data-lucide="phone" class="w-3 h-3 mr-1 text-slate-400"></i>
                      <%= c.contact_phone %>
                    </div>
                  <% end %>
                  <% if c.contact_email.present? %>
                    <div class="text-[11px] text-slate-400 flex items-center">
                      <i data-lucide="mail" class="w-3 h-3 mr-1 text-slate-400"></i>
                      <%= c.contact_email %>
                    </div>
                  <% end %>
                </td>

                <!-- Industry & Scale -->
                <td class="py-3.5 px-4">
                  <span class="font-semibold text-slate-800 block"><%= c.industry || 'Chưa phân loại' %></span>
                  <span class="text-[11px] text-slate-500"><%= c.company_size || '---' %></span>
                  <% if c.city.present? %>
                    <div class="text-[11px] text-slate-400 flex items-center mt-0.5">
                      <i data-lucide="map-pin" class="w-3 h-3 mr-1"></i><%= c.city %>
                    </div>
                  <% end %>
                </td>

                <!-- Status -->
                <td class="py-3.5 px-4">
                  <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full border inline-block <%= c.status_badge[:class] %>">
                    <%= c.status_badge[:label] %>
                  </span>
                </td>

                <!-- Debt & Credit Limit -->
                <td class="py-3.5 px-4">
                  <div class="font-bold <%= c.overdue? ? 'text-rose-600 text-sm' : 'text-slate-900' %>">
                    <%= format_vnd(c.current_debt) %>
                  </div>
                  <div class="text-[10px] text-slate-400">
                    Hạn mức: <%= format_vnd(c.credit_limit) %>
                  </div>
                  <div class="mt-1">
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded border inline-block <%= c.debt_badge[:class] %>">
                      <%= c.debt_badge[:label] %>
                    </span>
                  </div>
                </td>

                <!-- Assigned Rep -->
                <td class="py-3.5 px-4">
                  <% if c.assigned_user.present? %>
                    <div class="flex items-center space-x-1.5">
                      <div class="w-5 h-5 rounded-full bg-slate-200 text-slate-700 text-[10px] font-bold flex items-center justify-center">
                        <%= c.assigned_user.name.split.last[0] %>
                      </div>
                      <span class="text-xs font-medium text-slate-800"><%= c.assigned_user.name %></span>
                    </div>
                    <span class="text-[10px] text-slate-400 block ml-6"><%= c.assigned_user.role_label %></span>
                  <% else %>
                    <span class="text-xs text-slate-400 italic">Chưa phân công</span>
                  <% end %>
                </td>

                <!-- Actions -->
                <td class="py-3.5 px-4 text-right">
                  <div class="flex items-center justify-end space-x-1.5">
                    <a href="<%= customer_path(c) %>" class="px-2.5 py-1 bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 font-semibold rounded-lg transition" title="Xem chi tiết">
                      Chi tiết
                    </a>
                    <a href="<%= edit_customer_path(c) %>" class="p-1 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-100 transition" title="Chỉnh sửa">
                      <i data-lucide="edit-3" class="w-4 h-4"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
