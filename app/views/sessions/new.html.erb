<div class="min-h-[80vh] flex flex-col justify-center items-center py-6 px-4">
  <div class="w-full max-w-xl">
    <!-- Branding Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-600 text-white shadow-xl shadow-indigo-200 mb-4">
        <i data-lucide="building-2" class="w-8 h-8"></i>
      </div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">NexCRM <span class="text-indigo-600">B2B SaaS</span></h1>
      <p class="mt-2 text-sm text-slate-500">Cổng đăng nhập thống nhất dành cho nhân viên Sales, CS và Marketing</p>
    </div>

    <!-- Quick Demo Role Login Cards -->
    <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5 mb-8 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-xs font-bold tracking-wider uppercase text-indigo-900 flex items-center space-x-1.5">
          <i data-lucide="zap" class="w-4 h-4 text-amber-500"></i>
          <span>Đăng nhập nhanh 1-Click (Demo Tài khoản)</span>
        </h3>
        <span class="text-[11px] text-indigo-600 font-medium bg-white px-2 py-0.5 rounded-full border border-indigo-200">Không cần gõ mật khẩu</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        <!-- Admin Quick Login -->
        <%= button_to demo_login_path(role: "admin"), method: :post, class: "w-full text-left p-3 rounded-xl bg-white border border-slate-200 hover:border-rose-400 hover:shadow-md transition group" do %>
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-bold text-rose-700 bg-rose-50 px-2 py-0.5 rounded border border-rose-200">Admin</span>
            <i data-lucide="shield-check" class="w-3.5 h-3.5 text-rose-500"></i>
          </div>
          <p class="text-xs font-semibold text-slate-800">Quản trị viên</p>
          <p class="text-[10px] text-slate-500">Toàn quyền hệ thống</p>
        <% end %>

        <!-- Sales Quick Login -->
        <%= button_to demo_login_path(role: "sales"), method: :post, class: "w-full text-left p-3 rounded-xl bg-white border border-slate-200 hover:border-blue-400 hover:shadow-md transition group" do %>
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">Sales</span>
            <i data-lucide="target" class="w-3.5 h-3.5 text-blue-500"></i>
          </div>
          <p class="text-xs font-semibold text-slate-800">Nguyễn Văn Hùng</p>
          <p class="text-[10px] text-slate-500">Deal & Khách hàng</p>
        <% end %>

        <!-- CS Quick Login -->
        <%= button_to demo_login_path(role: "cs"), method: :post, class: "w-full text-left p-3 rounded-xl bg-white border border-slate-200 hover:border-emerald-400 hover:shadow-md transition group" do %>
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">CS</span>
            <i data-lucide="life-buoy" class="w-3.5 h-3.5 text-emerald-500"></i>
          </div>
          <p class="text-xs font-semibold text-slate-800">Trần Thị Mai</p>
          <p class="text-[10px] text-slate-500">Công nợ & Chăm sóc</p>
        <% end %>

        <!-- Marketing Quick Login -->
        <%= button_to demo_login_path(role: "marketing"), method: :post, class: "w-full text-left p-3 rounded-xl bg-white border border-slate-200 hover:border-purple-400 hover:shadow-md transition group" do %>
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-bold text-purple-700 bg-purple-50 px-2 py-0.5 rounded border border-purple-200">Marketing</span>
            <i data-lucide="pie-chart" class="w-3.5 h-3.5 text-purple-500"></i>
          </div>
          <p class="text-xs font-semibold text-slate-800">Lê Hoàng Nam</p>
          <p class="text-[10px] text-slate-500">Lead & Ngành nghề</p>
        <% end %>
      </div>
    </div>

    <!-- Standard Login Form Box -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xl shadow-slate-100 p-8">
      <div class="mb-6">
        <h2 class="text-lg font-bold text-slate-900">Đăng nhập tài khoản</h2>
        <p class="text-xs text-slate-500 mt-1">Sử dụng tài khoản được cấp bởi tổ chức để truy cập hệ thống</p>
      </div>

      <%= form_with url: login_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">Email làm việc</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i data-lucide="mail" class="w-4 h-4"></i>
            </div>
            <%= f.email_field :email, value: "sales@crm.saas", required: true, class: "w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition" %>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Mật khẩu</label>
            <span class="text-[11px] text-slate-400">Mặc định: password123</span>
          </div>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i data-lucide="lock" class="w-4 h-4"></i>
            </div>
            <%= f.password_field :password, value: "password123", required: true, class: "w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition" %>
          </div>
        </div>

        <div class="pt-2">
          <%= f.submit "Đăng nhập ngay", class: "w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-100 transition cursor-pointer flex items-center justify-center space-x-2" %>
        </div>
      <% end %>

      <!-- Information notes -->
      <div class="mt-6 pt-6 border-t border-slate-100 flex items-start space-x-3 text-xs text-slate-500">
        <i data-lucide="info" class="w-4 h-4 text-indigo-500 shrink-0 mt-0.5"></i>
        <span>Hệ thống CRM phiên bản SaaS không yêu cầu đăng ký tự do, toàn bộ dữ liệu khách hàng B2B, phân quyền và hạn mức công nợ được quản lý tập trung.</span>
      </div>
    </div>
  </div>
</div>
